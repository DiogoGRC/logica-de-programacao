Algoritmo "exemplo" 
    //nome dado pela trilha de aprendizagem(ads 12.10.26)

 Var // espaço reservado para declarar variáveis
    nome: caractere 
    // caractere é um tipo de dado que armazena letras, palavras ou frases
    idade: inteiro
    // inteiro é um tipo de dado que armazena números inteiros
 
 inicio 
 // inicio do algoritmo
    escreval("informe seu nome") 
    // faz que exiba na tela uma mensagem para o usuário. Trata-se de um comando de saída.
    leia(nome) 
    // faz que leia à caractere digitado pelo usuário e armazene na variável nome. Trata-se de um comando de entrada que espera que o usuário digite algo, e em seguia tecle 'enter'.
    escreval("informe a sua idade")
    leia(idade) 
    escreval("o nome informado foi ", nome, ", que tem ", idade, " anos de idade.")
    // faz exibir na tela o nome e a idade digitados pelo usuário.

fimalgoritmo // fim do algoritmo
